{
  "name": "fruit-snake",
  "version": "1.0.0",
  "description": "Fruit Snake \u2014 a friendly, kid-safe Snake game for iOS and Android (Capacitor).",
  "license": "MIT",
  "scripts": {
    "test": "node --test www/tests/*.test.mjs",
    "serve": "npx --yes http-server www -p 8080 -c-1 -o",
    "sync": "npx cap sync",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "icons": "npx --yes @capacitor/assets generate --iconBackgroundColor '#eafce9' --iconBackgroundColorDark '#2a1a44'"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@revenuecat/purchases-capacitor": "^9.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0"
  }
}
